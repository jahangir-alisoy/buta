# Copy to .env for docker compose or export in your shell. Never commit real values.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buta
DB_USER=buta
DB_PASSWORD=buta
DB_SSL_MODE=disable
DB_POOL_SIZE=10

# Runtime profile: dev (local), prod (deployed)
SPRING_PROFILES_ACTIVE=dev

# Application
APP_DEMO_MODE=true
APP_LIQUIBASE_CONTEXTS=default,demo
APP_PUBLIC_BASE_URL=http://localhost:8081
APP_ALLOWED_ORIGINS=http://localhost:5173
APP_ADMIN_EMAILS=admin@buta.test
APP_API_DOCS_ENABLED=true

# Secrets (production: at least 32 random bytes each, e.g. `openssl rand -base64 48`)
APP_OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789abcdef
APP_IP_HASH_SECRET=dev-only-ip-hash-secret-change-me-0123456789

# Session cookies (production: secure=true and the __Host- prefix)
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_NAME=buta_session

# Email (local: Mailpit on 1025, UI on http://localhost:8025)
APP_MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=Buta <no-reply@buta.test>

# Payments: sandbox only (allowed in production only when APP_DEMO_MODE=true)
APP_PAYMENT_PROVIDER=sandbox

# Avatar storage
APP_STORAGE_PROVIDER=database
APP_AVATAR_MAX_BYTES=2097152

# Frontend (Vite dev server proxies /api to the backend; leave empty to use same-origin /api)
VITE_API_BASE_URL=
